{
  "manifest_version": 3,
  "name": "YTDL Desktop Helper",
  "version": "1.4.1",
  "description": "Send any video page to your YTDL Desktop App — a one-click download button appears on any page with a video player.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:30123/*", "http://localhost:30123/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
